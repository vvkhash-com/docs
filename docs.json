{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Software and Systems Engineering",
  "theme": "luma",
  "colors": {
    "primary": "#040404"
  },
  "favicon": {
    "light": "/images/icon-devops-01.svg",
    "dark": "/images/icon-devops-01.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Notes",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "about"
            ]
          },
          {
            "group": "DevOps & CI/CD",
            "pages": [
              "devops/overview",
              "devops/docker",
              "devops/gitlab-cicd",
              "devops/kubernetes"
            ]
          },
          {
            "group": "Cloud & Infrastructure",
            "pages": [
              "cloud/aws",
              "cloud/gcp-azure",
              "cloud/terraform",
              "cloud/finops"
            ]
          },
          {
            "group": "Linux & Systems",
            "pages": [
              "linux/essentials",
              "linux/bash-scripting",
              "linux/networking",
              "linux/troubleshooting"
            ]
          },
          {
            "group": "macOS Tips",
            "pages": [
              "macos/tips",
              "macos/terminal"
            ]
          }
        ]
      },
      {
        "tab": "R&D"
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "vvkhash.com",
      "href": "https://vvkhash.com"
    },
    "links": [
      {
        "href": "mailto:hi@mintlify.com",
        "label": "Support"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vvkhash",
      "x": "https://x.com/vvkhash",
      "linkedin": "https://linkedin.com/in/vvkhash"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": false
  },
  "icons": {
    "library": "fontawesome"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/about",
      "permanent": true
    }
  ],
  "metadata": {
    "timestamp": true
  },
  "description": "Software and Systems Engineering",
  "logo": {
    "light": "/images/icon-devops-01.svg",
    "dark": "/images/icon-devops-01.svg"
  },
  "fonts": {
    "heading": {
      "family": "Roboto"
    },
    "body": {
      "family": "Roboto"
    }
  },
  "thumbnails": {
    "fonts": {
      "family": "Inter"
    }
  },
  "contextual": {
    "options": [
      "download-pdf"
    ],
    "display": "header"
  },
  "interaction": {
    "drilldown": true
  },
  "api": {
    "playground": {
      "credentials": true
    }
  },
  "seo": {
    "indexing": "navigable"
  }
}
